<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
    <%- include('_layouts/head') %>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons|Material+Icons+Two+Tone" rel="stylesheet">
    <title>Declaration Forms | <%= title %></title>
    <style>
        .decl-card { border-radius: 14px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.10); margin-bottom: 24px; }
        .decl-header { padding: 22px 26px; color: #fff; }
        .decl-header.pickup { background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); }
        .decl-header.return { background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%); color:#3a2e00; }
        .decl-header h5 { margin: 0; font-size: 1.2rem; font-weight: 600; }
        .decl-header p { margin: 6px 0 0; opacity: .85; font-size: .9rem; }
        .decl-body { padding: 26px; }
        .clause-row { display:flex; align-items:center; gap:10px; margin-bottom:10px; }
        .clause-row .clause-num { min-width:26px; font-weight:700; color:#888; }
        .clause-row .input-field { margin:0; flex:1; }
        .remove-row-btn { color:#e53935; cursor:pointer; }
        .add-row-btn { color:#7c4dff; cursor:pointer; font-weight:600; font-size:.9rem; }
        .save-btn { width:100%; height:46px; border-radius:26px; background:#333; color:#fff; font-weight:600; border:none; cursor:pointer; margin-top:14px; }
        .flow-note { background:#eef; color:#445; padding:10px 14px; border-radius:8px; font-size:.85rem; margin-bottom:18px; }
    </style>
</head>

<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
    data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">
    <%- include('_layouts/sidenavbar') %>

    <div id="main">
        <div class="row">
            <div id="breadcrumbs-wrapper" data-image="/app-assets/images/gallery/breadcrumb-bg.jpg">
                <div class="container">
                    <div class="row">
                        <div class="col s12 m6 l6">
                            <h5 class="breadcrumbs-title mt-0 mb-0">Declaration Forms</h5>
                        </div>
                        <div class="col s12 m6 l6 right-align-md">
                            <ol class="breadcrumbs mb-0">
                                <li class="breadcrumb-item"><a href="/admin">Home</a></li>
                                <li class="breadcrumb-item active">Declaration Forms</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container" style="margin-top:30px;">
                <div class="row">
                    <div class="col s12"><%- messages('messages', locals) %></div>
                </div>

                <div class="row">
                    <div class="col s12">
                        <p class="flow-note">
                            <i class="material-icons" style="vertical-align:middle;font-size:18px;">info</i>
                            App flow: renter always sees the <strong>Pickup</strong> form + signs first, then the
                            <strong>Return</strong> form + signs — the backend blocks a return signature until the
                            pickup one is completed.
                        </p>
                    </div>
                </div>

                <div class="row">
                    <!-- PICKUP FORM -->
                    <div class="col s12 m6">
                        <div class="card decl-card">
                            <div class="decl-header pickup">
                                <h5><i class="material-icons" style="vertical-align:middle;margin-right:8px;">login</i>1. Pickup Declaration Form</h5>
                                <p>Shown before the renter signs at car pickup.</p>
                            </div>
                            <div class="decl-body">
                                <form method="POST" action="/admin/declaration-forms/pickup">
                                    <div class="input-field">
                                        <input type="text" name="title" value="<%= pickupForm.title %>" required>
                                        <label class="active">Form title</label>
                                    </div>

                                    <div id="pickupClauses">
                                        <% pickupForm.clauses.sort((a,b)=>a.order-b.order).forEach(function(c, idx) { %>
                                        <div class="clause-row">
                                            <span class="clause-num"><%= idx + 1 %>.</span>
                                            <div class="input-field">
                                                <input type="text" name="clauseText" value="<%= c.text %>" required>
                                            </div>
                                            <i class="material-icons remove-row-btn" onclick="this.closest('.clause-row').remove()">delete</i>
                                        </div>
                                        <% }) %>
                                    </div>
                                    <span class="add-row-btn" onclick="addClauseRow('pickupClauses')">+ Add clause</span>

                                    <button type="submit" class="save-btn">Save Pickup Form</button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- RETURN FORM -->
                    <div class="col s12 m6">
                        <div class="card decl-card">
                            <div class="decl-header return">
                                <h5><i class="material-icons" style="vertical-align:middle;margin-right:8px;">logout</i>2. Return Declaration Form</h5>
                                <p>Shown before the renter signs at car return.</p>
                            </div>
                            <div class="decl-body">
                                <form method="POST" action="/admin/declaration-forms/return">
                                    <div class="input-field">
                                        <input type="text" name="title" value="<%= returnForm.title %>" required>
                                        <label class="active">Form title</label>
                                    </div>

                                    <div id="returnClauses">
                                        <% returnForm.clauses.sort((a,b)=>a.order-b.order).forEach(function(c, idx) { %>
                                        <div class="clause-row">
                                            <span class="clause-num"><%= idx + 1 %>.</span>
                                            <div class="input-field">
                                                <input type="text" name="clauseText" value="<%= c.text %>" required>
                                            </div>
                                            <i class="material-icons remove-row-btn" onclick="this.closest('.clause-row').remove()">delete</i>
                                        </div>
                                        <% }) %>
                                    </div>
                                    <span class="add-row-btn" onclick="addClauseRow('returnClauses')">+ Add clause</span>

                                    <button type="submit" class="save-btn">Save Return Form</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('_layouts/commonJs') %>
    <script>
        function addClauseRow(containerId) {
            const container = document.getElementById(containerId);
            const num = container.querySelectorAll('.clause-row').length + 1;
            const div = document.createElement('div');
            div.className = 'clause-row';
            div.innerHTML = `
                <span class="clause-num">${num}.</span>
                <div class="input-field"><input type="text" name="clauseText" required></div>
                <i class="material-icons remove-row-btn" onclick="this.closest('.clause-row').remove()">delete</i>`;
            container.appendChild(div);
        }
    </script>
</body>
</html>