<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
    <%- include('_layouts/head') %>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons|Material+Icons+Two+Tone" rel="stylesheet">
    <title>Rent Fare Settings | <%= title %></title>
    <style>
        .fare-card { border-radius: 14px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.10); margin-bottom: 24px; }
        .fare-header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 22px 26px; color: #fff; }
        .fare-header h5 { margin: 0; font-size: 1.2rem; font-weight: 600; }
        .fare-header p { margin: 6px 0 0; opacity: .85; font-size: .9rem; }
        .fare-body { padding: 26px; }
        .save-btn { width:100%; height:48px; border-radius:30px; background:linear-gradient(135deg,#667eea 0%,#764ba2 100%); color:#fff; font-weight:600; font-size:1rem; border:none; cursor:pointer; margin-top:10px; box-shadow:0 4px 15px rgba(102,126,234,.4); }
        .section-title { font-weight:700; color:#444; margin:0 0 14px; font-size:1rem; border-left:4px solid #7c4dff; padding-left:10px; }
        .formula-box { background:#f7f4ff; border-left:4px solid #7c4dff; border-radius:8px; padding:14px 18px; color:#444; font-size:.95rem; line-height:1.7; }
        .formula-box strong { color:#5e35b1; }
        .hint { color:#888; font-size:.85rem; margin-top:4px; }
    </style>
</head>

<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
    data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">
    <%- include('_layouts/sidenavbar') %>

    <div id="main">
        <div class="row">
            <div id="breadcrumbs-wrapper" data-image="/app-assets/images/gallery/breadcrumb-bg.jpg">
                <div class="container">
                    <div class="row">
                        <div class="col s12 m6 l6">
                            <h5 class="breadcrumbs-title mt-0 mb-0">Rent Fare Settings</h5>
                        </div>
                        <div class="col s12 m6 l6 right-align-md">
                            <ol class="breadcrumbs mb-0">
                                <li class="breadcrumb-item"><a href="/admin">Home</a></li>
                                <li class="breadcrumb-item"><a href="/admin/fare-settings">Fare Settings</a></li>
                                <li class="breadcrumb-item active">Rent</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container" style="margin-top:30px;">
                <div class="row">
                    <div class="col s12"><%- messages('messages', locals) %></div>
                </div>

                <form method="POST" action="/admin/fare-settings/rent">
                    <div class="row">
                        <!-- Delivery Fee -->
                        <div class="col s12 m4">
                            <div class="card fare-card">
                                <div class="fare-header">
                                    <h5><i class="material-icons" style="vertical-align:middle;margin-right:8px;">local_shipping</i>Delivery Fee</h5>
                                    <p>Charged when user selects "Deliver to you".</p>
                                </div>
                                <div class="fare-body">
                                    <div class="row" style="margin-bottom:0;">
                                        <div class="input-field col s12">
                                            <input id="deliveryFee" name="deliveryFee" type="number" step="0.01" min="0"
                                                value="<%= rent.deliveryFee %>" required>
                                            <label for="deliveryFee" class="active">Delivery Fee ($)</label>
                                        </div>
                                    </div>
                                    <p class="hint">Pickup from owner location is always Free.</p>
                                </div>
                            </div>
                        </div>

                        <!-- Service Fee -->
                        <div class="col s12 m4">
                            <div class="card fare-card">
                                <div class="fare-header">
                                    <h5><i class="material-icons" style="vertical-align:middle;margin-right:8px;">receipt_long</i>Service Fee</h5>
                                    <p>Flat fee added to every rent booking.</p>
                                </div>
                                <div class="fare-body">
                                    <div class="row" style="margin-bottom:0;">
                                        <div class="input-field col s12">
                                            <input id="serviceFee" name="serviceFee" type="number" step="0.01" min="0"
                                                value="<%= rent.serviceFee %>" required>
                                            <label for="serviceFee" class="active">Service Fee ($)</label>
                                        </div>
                                    </div>
                                    <p class="hint">Applies to both Pickup and Delivery bookings.</p>
                                </div>
                            </div>
                        </div>

                        <!-- Tax -->
                        <div class="col s12 m4">
                            <div class="card fare-card">
                                <div class="fare-header">
                                    <h5><i class="material-icons" style="vertical-align:middle;margin-right:8px;">account_balance</i>Tax</h5>
                                    <p>Percentage tax on the booking amount.</p>
                                </div>
                                <div class="fare-body">
                                    <div class="row" style="margin-bottom:0;">
                                        <div class="input-field col s12">
                                            <input id="taxPercentage" name="taxPercentage" type="number" step="0.01" min="0" max="100"
                                                value="<%= rent.taxPercentage %>" required>
                                            <label for="taxPercentage" class="active">Tax (%)</label>
                                        </div>
                                    </div>
                                    <p class="hint">Applied on car rent + delivery fee + service fee.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col s12 m6 offset-m3">
                            <button type="submit" class="save-btn">Save Rent Fare Settings</button>
                        </div>
                    </div>
                </form>

                <!-- How the user total is calculated (no numbers) -->
                <div class="row">
                    <div class="col s12">
                        <p class="section-title">How the user's rent total is calculated</p>
                        <div class="formula-box">
                            <strong>Total</strong> = (<strong>Car price per day</strong> &times; <strong>Days</strong>)
                            + <strong>Delivery Fee</strong> + <strong>Service Fee</strong> + <strong>Tax</strong><br>
                            <span style="color:#777;">
                                Car price per day is set by the driver when adding the car.
                                Delivery Fee, Service Fee and Tax are managed from this page.
                            </span>
                        </div>
                        <% if (updatedAt) { %>
                            <p class="hint" style="margin-top:12px;">
                                Last updated: <%= new Date(updatedAt).toLocaleString('en-IN') %>
                            </p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('_layouts/commonJs') %>
</body>
</html>