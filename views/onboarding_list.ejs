<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<!-- BEGIN: Head-->

<head>
    <%- include('_layouts/head') %>
    <title>Onboarding Screens | <%= title %></title>
    <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/jquery.dataTables.min.css">
    <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/extensions/responsive/css/responsive.dataTables.min.css">
    <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/select.dataTables.min.css">
    <link rel="stylesheet" type="text/css" href="/app-assets/css/pages/data-tables.css">
</head>
<!-- END: Head-->

<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
    data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

    <%- include('_layouts/sidenavbar') %>

    <!-- BEGIN: Page Main-->
    <div id="main">
        <div class="row">
            <div id="breadcrumbs-wrapper" data-image="/app-assets/images/gallery/breadcrumb-bg.jpg">
                <div class="container">
                    <div class="row">
                        <div class="col s12 m6 l6">
                            <h5 class="breadcrumbs-title mt-0 mb-0"><span>Onboarding Screens</span></h5>
                        </div>
                        <div class="col s12 m6 l6 right-align-md">
                            <a class="btn gradient-45deg-purple-deep-orange pull-right btn-breadcrumbs" href="/admin/onboarding-screens/add">Add Screen</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col s12">
                <div class="container">
                    <div class="section section-data-tables">
                        <div class="row">
                            <div class="col s12">
                                <div class="card">
                                    <div class="card-content">
                                        <%- messages('messages', locals) %>
                                        <div class="row">
                                            <div class="col s12 overflow">
                                                <table id="page-length-option" class="display">
                                                    <thead>
                                                        <tr>
                                                            <th>Sr</th>
                                                            <th>Order</th>
                                                            <th>Image</th>
                                                            <th>Title</th>
                                                            <th>Description</th>
                                                            <th>Active</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% if (screens && screens.length) { %>
                                                            <% screens.forEach(function(s, i) { %>
                                                            <tr>
                                                                <td><%= i + 1 %></td>
                                                                <td><%= s.order %></td>
                                                                <td>
                                                                    <img src="<%= s.image %>" alt="<%= s.title %>" width="60"
                                                                        onerror="this.onerror=null; this.src='/uploads/no_image_available_3.jpg';"
                                                                        style="border-radius: 6px; object-fit: cover;">
                                                                </td>
                                                                <td><strong><%= s.title %></strong></td>
                                                                <td style="max-width: 280px; white-space: normal;"><%= s.description %></td>
                                                                <td>
                                                                    <form method="POST" action="/admin/onboarding-screens/toggle/<%= s._id %>" style="margin:0;">
                                                                        <div class="switch">
                                                                            <label>
                                                                                <input type="checkbox" <%= s.isActive ? 'checked' : '' %> onchange="this.form.submit()">
                                                                                <span class="lever"></span>
                                                                            </label>
                                                                        </div>
                                                                    </form>
                                                                </td>
                                                                <td style="max-width: 90px;">
                                                                    <a href="/admin/onboarding-screens/edit/<%= s._id %>" title="Edit">
                                                                        <i class="material-icons">create</i>
                                                                    </a>
                                                                    <a href="/admin/onboarding-screens/delete/<%= s._id %>"
                                                                        onclick="return confirm('Is screen ko delete karna he?')"
                                                                        title="Delete">
                                                                        <i class="material-icons">delete</i>
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                        <% } %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-overlay"></div>
            </div>
        </div>
    </div>
    <!-- END: Page Main-->

    <%- include('_layouts/commonJs') %>
    <script src="/app-assets/vendors/data-tables/js/jquery.dataTables.min.js"></script>
    <script src="/app-assets/js/scripts/data-tables.js"></script>
</body>

</html>